GEMINI_API_KEY=

# Communications Service used for email, SMS, voice, and Ask delivery.
COMMUNICATIONS_API_URL=
# Outbound X-API-Key credential. Backend only; never put this in VITE_* or app settings.
COMMUNICATIONS_API_KEY=
# Shared HMAC-SHA256 secret used to verify raw /api/events request bodies.
# Must match COMMUNICATIONS_WEBHOOK_SECRET in Communications Service.
COMMUNICATIONS_WEBHOOK_SECRET=
# Optional global E.164 sender fallback. Prefer the tenant setting in HyperFlow.
COMMUNICATIONS_FROM_NUMBER=
# Optional global email fallbacks. Prefer per-tenant Settings > Communications.
COMMUNICATIONS_EMAIL_IDENTITY=
COMMUNICATIONS_CONNECTION_ID=
# Optional Gemini model used only for conservative inbound-intent extraction.
COMMUNICATIONS_INTENT_MODEL=gemini-3.5-flash

# Required by /api/schedules/tick. Vercel Cron sends CRON_SECRET as a Bearer token.
# Use SCHEDULER_SECRET only for an additional non-Vercel timer caller.
CRON_SECRET=
SCHEDULER_SECRET=
# Optional comma-separated hostname allowlist for webhook action destinations.
# Even without an allowlist, only public HTTPS addresses on port 443 are allowed.
WEBHOOK_ALLOWED_HOSTS=
# --- Server-side flow orchestration ---
# Public origin used to build tokenized ask links. Example: https://app.example.com
PUBLIC_BASE_URL=

# Shared secret for POST /api/flow/advance (x-webhook-secret header).
WEBHOOK_SECRET=

# REQUIRED for webhooks and server-side flow. The one real Firebase secret:
# it bypasses database.rules.json entirely, so treat it accordingly.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Accepts the JSON directly or base64-encoded (use base64 if your host mangles
# the newlines in the private key).
FIREBASE_SERVICE_ACCOUNT=

# Optional. Defaults to the hyper-flow-a459b database, matching the browser.
# Only set this if you also override VITE_FIREBASE_DATABASE_URL — the browser and
# the server MUST point at the same database or answers land in two places with
# no error to tell you.
FIREBASE_DATABASE_URL=

# --- Firebase (browser) — all optional ---
# The app ships with a working hyper-flow-a459b config. A web config is not a
# secret (it reaches every visitor in the bundle regardless); security comes from
# database.rules.json. Set these only to point a deployment at a DIFFERENT
# Firebase project. api key + project id + database URL are required together —
# a partial override is ignored.
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Region-specific. us-central1 looks like
#   https://<project-id>-default-rtdb.firebaseio.com
# every other region looks like
#   https://<project-id>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Derived from the project id when omitted:
#   authDomain     <project-id>.firebaseapp.com
#   storageBucket  <project-id>.firebasestorage.app
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MEASUREMENT_ID=
