GEMINI_API_KEY=
RESEND_API_KEY=

# AI voice calls (phone call nodes)
BLAND_API_KEY=

# SMS nodes — leave blank to run in stub mode (logs only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Server-side flow orchestration ---
# Public origin providers call back on. Must be reachable from the internet:
# in local dev use a tunnel (e.g. ngrok) rather than http://localhost:3000.
# Without this, calls fall back to browser polling.
PUBLIC_BASE_URL=

# Shared secret for inbound webhooks (?secret=) and POST /api/flow/advance
# (x-webhook-secret header). Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Firebase Admin credentials, so webhooks can persist without a browser.
# FIREBASE_SERVICE_ACCOUNT accepts the service-account JSON directly or
# base64-encoded (use base64 if your host mangles newlines in the private key).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=
