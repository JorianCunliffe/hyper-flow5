GEMINI_API_KEY=
RESEND_API_KEY=

# AI voice calls (phone call nodes)
BLAND_API_KEY=

# SMS nodes — leave blank to run in stub mode (logs only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Server-side flow orchestration ---
# Public origin providers call back on. Must be reachable from the internet:
# in local dev use a tunnel (e.g. ngrok) rather than http://localhost:3000.
# Without this, calls fall back to browser polling.
PUBLIC_BASE_URL=

# Shared secret for inbound webhooks (?secret=) and POST /api/flow/advance
# (x-webhook-secret header). Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Firebase Admin credentials, so webhooks can persist without a browser.
# FIREBASE_SERVICE_ACCOUNT accepts the service-account JSON directly or
# base64-encoded (use base64 if your host mangles newlines in the private key).
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
# Must be the SAME database the browser uses (VITE_FIREBASE_DATABASE_URL below).
FIREBASE_DATABASE_URL=

# --- Firebase (browser) ---
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
# Without these the app runs local-only (localStorage) rather than connecting to
# somebody else's database.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Region-specific. us-central1 looks like
#   https://<project-id>-default-rtdb.firebaseio.com
# every other region looks like
#   https://<project-id>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Optional — derived from the project id when omitted:
#   authDomain     <project-id>.firebaseapp.com
#   storageBucket  <project-id>.firebasestorage.app
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MEASUREMENT_ID=
