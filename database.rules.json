{
  "rules": {
    ".read": false,
    ".write": false,

    "invites": {
      ".read": false,
      ".write": false
    },

    "projects": {
      "$orgId": {
        ".read": "auth != null && root.child('organizations').child($orgId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('organizations').child($orgId).child('members').child(auth.uid).exists()"
      }
    },

    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },

    "organizations": {
      "$orgId": {
        ".read": "auth != null && root.child('organizations').child($orgId).child('members').child(auth.uid).exists()",
        ".write": false
      }
    },

    "accounts": {
      ".read": false,
      ".write": false
    },

    "external_events": {
      ".read": false,
      ".write": false
    },

    "ask_resolutions": {
      ".read": false,
      ".write": false
    },

    "communication_delivery": {
      ".read": false,
      ".write": false
    },

    "triage_items": {
      ".read": false,
      ".write": false,
      "$orgId": {
        ".indexOn": "updatedAt"
      }
    },

    "schedules": {
      ".read": false,
      ".write": false
    },

    "schedule_runs": {
      ".read": false,
      ".write": false
    },

    "communication_cursors": {
      ".read": false,
      ".write": false
    },

    "serverActivity": {
      ".read": false,
      ".write": false
    }
  }
}
