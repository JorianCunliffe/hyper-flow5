{
  "rules": {
    "invites": {
      ".read": "true",
      ".write": "auth != null && (data.exists() ? true : root.child('users').child(auth.uid).child('orgId').val() == newData.child('orgId').val())"
    },
    "projects": {
      "$orgId": {
        ".read": "root.child('users').child(auth.uid).child('orgId').val() === $orgId",
        ".write": "root.child('users').child(auth.uid).child('orgId').val() === $orgId"
      }
    },
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "organizations": {
      "$orgId": {
        ".read": "root.child('users').child(auth.uid).child('orgId').val() === $orgId",
        ".write": "root.child('users').child(auth.uid).child('orgId').val() === $orgId"
      }
    },
    "accounts": {
      ".read": "true"
    }
  }
}
