{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/forms/ask/:token", "destination": "/api/asks/:token" },
    { "source": "/api/schedules/run", "destination": "/api/schedules?action=run" },
    { "source": "/api/schedules/tick", "destination": "/api/schedules?action=tick" },
    { "source": "/api/integrations", "destination": "/api/communications/status?action=integrations" },
    { "source": "/api/integrations/google/start", "destination": "/api/communications/status?action=google_start" },
    { "source": "/api/integrations/google/callback", "destination": "/api/communications/status?action=google_callback" },
    { "source": "/api/integrations/google/resources", "destination": "/api/communications/status?action=google_resources" },
    { "source": "/api/integrations/google/grant", "destination": "/api/communications/status?action=workspace_grant" },
    { "source": "/api/integrations/google/document", "destination": "/api/communications/status?action=google_doc" },
    { "source": "/api/integrations/google/sheet", "destination": "/api/communications/status?action=google_sheet" },
    { "source": "/api/integrations/mailbox/start", "destination": "/api/communications/status?action=mailbox_start" },
    { "source": "/api/integrations/mailbox/sync", "destination": "/api/communications/status?action=mailbox_sync" },
    { "source": "/api/coaching/sessions", "destination": "/api/communications/status?action=coaching_sessions" },
    { "source": "/api/agent/voice-context", "destination": "/api/events?action=voice_context" },
    { "source": "/api/operations", "destination": "/api/communications/status?action=operations" },
    { "source": "/api/operations/agent-jobs/replay", "destination": "/api/communications/status?action=operations_replay" },
    { "source": "/api/gemini/brainstormSubtasks", "destination": "/api/gemini?action=brainstormSubtasks" },
    { "source": "/api/gemini/generateProjectStructure", "destination": "/api/gemini?action=generateProjectStructure" }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/schedules/tick", "schedule": "0 0 * * *" }
  ]
}
